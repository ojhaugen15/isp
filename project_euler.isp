:e currentTriangular

:countDivisors inputNumber
:a squareRooted :squareRoot inputNumber;
:a currentNumber :roundDown squareRooted;
:a outputCount 2
:i :areSame squareRooted currentNumber
::a outputCount :addNumbers outputCount 1;
