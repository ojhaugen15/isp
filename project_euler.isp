% ProjectEuler.net problems are really more math problems (but,
% thereby, can all be finessed into computer-programming problems)


% Problem 12: https://projecteuler.net/problem=12

:firstTriangular numberDivisors
:a currentTriangular 1
:a nextFactor 2
:i :areSame :firstGreater :countDivisors currentTriangular; numberDivisors; false;
::a currentTriangular :addNumbers currentTriangular nextFactor;
::a nextFactor :addNumbers nextFactor 1;
:e currentTriangular

:countDivisors inputNumber
:a squareRooted :squareRoot inputNumber;
:a currentNumber :roundDown squareRooted;
:a outputCount 2
:i :areSame squareRooted currentNumber
::a outputCount :addNumbers outputCount 1;
::a currentNumber :differenceNumbers currentNumber 1;
:i :arentSame currentNumber 1;
::a remainderResult :remainderNumbers inputNumber currentNumber;
::i :areSame remainderResult 0;
:::a outputCount :addNumbers outputCount 2;
:::a remainderResult undefined
::a currentNumber :differenceNumbers currentNumber 1;
:e outputCount


% Problem 5: https://projecteuler.net/problem=5

:smallestMultiple topNumber
:a outputNumber 1
:a currentNumber 2
:i :arentSame :firstGreater currentNumber topNumber; true;
::a foundPrime :isPrime currentNumber;
::i :areSame foundPrime true;
:::a outputNumber :productNumbers outputNumber :largestPower topNumber currentNumber;;
:::a foundPrime false
::a currentNumber :addNumbers currentNumber 1;
:e outputNumber

:largestPower limitNumber mainNumber
:a outputNumber mainNumber
:a nextPower :productNumbers mainNumber mainNumber;
:i :firstGreater limitNumber nextPower;
::a outputNumber nextPower
::a nextPower :productNumbers outputNumber mainNumber;
:e outputNumber


% Problem 1: https://projecteuler.net/problem=1

:sumMultiples smallerNumber largerNumber numberBelow searchIndex outputSum
:i :arentSame numberBelow searchIndex;
::i :isMultiple searchIndex smallerNumber;
:::e :sumMultiples smallerNumber largerNumber numberBelow :multiplyNumbers outputSum searchIndex; :addNumbers searchIndex 1;;
::i :isMultiple searchIndex largerNumber;
:::a outputSum :multiplyNumbers outputSum searchIndex;
:::e :sumMultiples smallerNumber largerNumber numberBelow :multiplyNumbers outputSum searchIndex; :addNumbers searchIndex 1;;
::a searchIndex :addNumbers searchIndex 1;
:e outputSum

sumMultiples 3 5 1000 1 1
